# 暗影地牢 · 环境变量模板
# 复制为 .env 后填入你自己的值：cp .env.example .env
# .env 不会提交到仓库；本文件是模板，只含占位符，可以放心入库。

# ============ 必填 ============

# 模型 API Key（OpenAI 兼容端点的 Key，如阿里云百炼 DashScope 的 sk-xxx）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# ============ 可选（不填走 config.py 默认值）============

# 模型服务地址（OpenAI 兼容端点）
#DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 聊天模型名
#DASHSCOPE_CHAT_MODEL=qwen3.7-max
